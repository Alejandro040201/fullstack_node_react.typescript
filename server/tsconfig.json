{
   "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["esnext", "DOM"],
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "strict": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true
   },
   "include": ["src/**/*.ts"]
}